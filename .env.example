# Taurus Stack Docker Compose 环境变量
# 复制为 .env 后修改

# ====== 数据库 ======
DB_PASSWORD=taurus

# ====== Redis ======
REDIS_PASSWORD=

# ====== JWT / 鉴权 ======
JWT_SECRET=change-me-in-production
AUTH_SECRET_KEY=change-me-in-production
MACAROON_ROOT_KEY=change-me-in-production

# ====== Executor ======
EXECUTOR_HOST_UUID=docker-host-001

# ====== Supervisor ======
SUPERVISOR_HOST_ID=supervisor-001
SUPERVISOR_SIGNING_SECRET=