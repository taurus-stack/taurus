# Taurus Stack Docker Compose 环境变量
# 复制为 .env 后修改

# ====== 数据库 ======
DB_PASSWORD=taurus

# ====== Redis ======
REDIS_PASSWORD=

# ====== JWT / 鉴权 ======
JWT_SECRET=change-me-in-production
AUTH_SECRET_KEY=change-me-in-production
MACAROON_ROOT_KEY=change-me-in-production
BACKEND_JWT_EXPIRES_MINUTES=60
TICKET_DEFAULT_EXPIRES_MINUTES=5
TICKET_MAX_EXPIRES_MINUTES=60

# ====== Backend ======
TAURUS_EDITION=community
TAURUS_AUTH_URL=http://taurus-auth:8001

# ====== WebSocket ======
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765

# ====== Executor ======
EXECUTOR_HOST_UUID=docker-host-001
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# ====== Supervisor ======
SUPERVISOR_HOST_ID=supervisor-001
SUPERVISOR_SIGNING_SECRET=
SUPERVISOR_HEARTBEAT_INTERVAL=10
HEALTH_CHECK_INTERVAL=10

# ====== Scheduler ======
SCHEDULER_INSTANCE_ID=scheduler-01
SCHEDULER_JOB_SYNC_INTERVAL=10
SCHEDULER_MISFIRE_GRACE_SECONDS=3600
SCHEDULER_LEADER_LOCK_TTL=30
SCHEDULER_DEDUP_TTL=600

# ====== Scheduler Worker ======
WORKER_CONCURRENCY=4
TAURUS_SCHEDULER_QUEUE=taurus:scheduler:queue:script_task